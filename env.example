# --- Required ---------------------------------------------------------------

YDB_URLS_CONNECTION_STRING=grpc://localhost:2136?database=/local
YDB_VISITS_CONNECTION_STRING=grpc://localhost:2136?database=/local
# Public base URL used to build short links. A trailing slash is trimmed.
ORIGIN=http://localhost:8080
VISITS_TABLE_PATH=/local/visits

# Keys the permutation that turns counter values into short codes. Without it
# codes would come out as 1, 2, 3... and anyone could enumerate every link.
# Generate with: openssl rand -hex 32
#
# NEVER change this once links exist. A different key is a different
# permutation, so codes minted afterwards can collide with codes minted before.
CODE_SECRET=change-me-openssl-rand-hex-32

# --- Optional (defaults shown) ----------------------------------------------

# server   - the HTTP API. Safe on a serverless container.
# consumer - drains /topics/visits into the visits table. MUST run somewhere
#            with continuously allocated CPU (VM, Managed k8s). A serverless
#            instance is suspended between requests, so this loop would only
#            advance during unrelated traffic and would be killed mid-batch.
# all      - both in one process. Same always-on requirement as `consumer`;
#            convenient for docker compose and single-VM deployments.
APP_ROLE=server

# How to authenticate to YDB.
#   metadata  - instance metadata service (default when APP_ENV=production)
#   cli       - shells out to `yc iam create-token` (default otherwise).
#               Needs the yc CLI on PATH, so it does NOT work in a container.
#   anonymous - no credentials, for a local YDB started with
#               YDB_ANONYMOUS_CREDENTIALS=1
# YDB_CREDENTIALS=cli

PORT=8080

# development | production. An unrecognised value aborts startup rather than
# silently falling back, since production uses different database credentials.
APP_ENV=development

# Where to read the client IP from. Must match your deployment topology:
#   ConnectInfo             - server is directly exposed (default)
#   XRealIp                 - behind a proxy setting X-Real-IP
#   RightmostXForwardedFor  - behind a proxy setting X-Forwarded-For
#   CfConnectingIp, FlyClientIp, TrueClientIp, XEnvoyExternalAddress, ...
# This also selects the rate-limiter key, so getting it wrong either lets
# clients spoof past the limit or buckets every user behind the proxy together.
CLIENT_IP_SOURCE=ConnectInfo

# Characters per short code, 1..=10. Codes cannot collide at any length; this
# caps how many links can ever exist (62^n) and how long the URLs look.
CODE_LENGTH=8

# Counter values claimed per database round-trip. Higher means fewer writes to
# the counter row; values left over when a process exits are skipped.
CODE_BLOCK_SIZE=1000

# Per-client-IP rate limit on POST /api/shorten. One request slot is
# replenished every RATE_LIMIT_REFILL_SECONDS, up to a burst of RATE_LIMIT_BURST.
RATE_LIMIT_REFILL_SECONDS=1
RATE_LIMIT_BURST=20

# Serve /swagger-ui and /api-docs/openapi.json.
# Defaults to false when APP_ENV=production.
ENABLE_SWAGGER=true

# Create the urls/visits tables on startup, then serve as normal.
RUN_MIGRATIONS=false

# --- Logging ----------------------------------------------------------------

RUST_LOG=urlshortener=debug,tower_http=debug
RUST_BACKTRACE=1
